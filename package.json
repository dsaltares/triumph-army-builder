{
  "name": "triumph-army-builder",
  "version": "0.1.0",
  "description": "Army builder for the Triumph! historical miniature wargame",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "yarn db:migrate && yarn db:seed && yarn db:seed:reference && next dev --port 3013",
    "build": "next build",
    "start": "next start --port 3013",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run --project unit --coverage && vitest run --project ui",
    "test:watch": "vitest",
    "test:real-data": "vitest run --project real-data",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dev": "E2E_SERVER=dev playwright test",
    "sync:meshwesh": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-meshwesh.ts",
    "validate:snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-snapshot.ts",
    "data:pack": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data-pack.ts",
    "data:sample": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data-pack.ts --snapshot test/fixtures/reference/snapshot --curation test/fixtures/reference/curation --translations test/fixtures/reference/translations --out test/fixtures/reference/sample-pack.json",
    "check:restricted": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-restricted.ts",
    "refresh:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/refresh-report.ts",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/migrate.ts",
    "db:sweep": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/sweep-anonymous.ts",
    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/backup-database.ts",
    "db:import-reference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/import-reference.ts",
    "db:copy-down": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/copy-down.ts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/seed-dev.ts",
    "db:seed:reference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/seed-reference.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@ip-location-db/dbip-city-mmdb": "2.3.2026060513",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@react-pdf/renderer": "4.9.0",
    "@tabler/icons-react": "3.46.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "better-auth": "1.7.5",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "fuse.js": "7.5.0",
    "kysely": "0.29.6",
    "maxmind": "5.0.7",
    "next": "16.1.6",
    "next-intl": "^4.14.5",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "qrcode-generator": "2.0.4",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "recharts": "3.8.0",
    "shadcn": "4.21.0",
    "sharp": "0.34.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "5.103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
